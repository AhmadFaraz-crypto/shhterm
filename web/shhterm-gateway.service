[Unit]
Description=shhterm web gateway (HTTPS + WebSocket -> C++ server)
After=network-online.target shhterm-server.service
Wants=network-online.target

[Service]
Type=simple
# Needs to bind :443; granted the capability rather than running as root.
User=shhterm
Group=shhterm
AmbientCapabilities=CAP_NET_BIND_SERVICE
Environment=SHHTERM_PORT=443
Environment=SHHTERM_UPSTREAM=127.0.0.1:8443
Environment=SHHTERM_WEBROOT=/opt/shhterm/web
# Browser-facing TLS cert (use your Let's Encrypt fullchain/privkey here).
Environment=SHHTERM_TLS_CERT=/etc/shhterm/web-fullchain.pem
Environment=SHHTERM_TLS_KEY=/etc/shhterm/web-privkey.pem
# Optional: verify the local hop to the C++ server. Set both to the server's
# own cert and the SNI matching its certificate's SAN. Left unset here, the
# loopback hop is unverified (it still uses TLS) — fine for 127.0.0.1.
# Environment=SHHTERM_UPSTREAM_CA=/etc/shhterm/server.crt
# Environment=SHHTERM_UPSTREAM_SNI=your.server.example
ExecStart=/usr/bin/node /opt/shhterm/web/gateway.js
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadOnlyPaths=/etc/shhterm /opt/shhterm/web

[Install]
WantedBy=multi-user.target
